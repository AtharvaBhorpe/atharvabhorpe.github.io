---
import Base from '../layouts/Base.astro';
import Navigation from '../components/Navigation.astro';
import Contact from '../components/Contact.astro';
import WritingList from '../components/WritingList.astro';
import { getCollection } from 'astro:content';
import { homeSections, homeProjects } from '../data/site';
import '../styles/home.css';
const projects = await getCollection('projects');
---
<Base home title="Atharva Bhorpe | Robotics projects and writing" description="Explore Atharva Bhorpe’s robotics projects, engineering contributions and technical tutorials.">
  <div class="page-scroll">
    <div class="stage layout">
      <Navigation sections={homeSections} />
      <main class="content" id="main-content">
        <section class="hero" id="home" tabindex="-1" aria-labelledby="intro-heading">
          <div class="hero-portrait" id="about" tabindex="-1"><img data-hero="media" src="/images/portrait.png" width="1254" height="1254" alt="Portrait of Atharva Bhorpe" fetchpriority="high" /></div>
          <div class="hero-copy" data-hero="intro">
            <h1 id="intro-heading">I build learning-based robotic systems.</h1>
            <p>I’m Atharva Bhorpe, a robotics master’s student at RWTH Aachen with a background in mechanical engineering and industrial automation.</p>
            <div class="hero-actions"><a class="action" href="#projects">Explore projects <span class="arrow" aria-hidden="true">↓</span></a><a class="secondary-action" href="/resume.pdf" target="_blank" rel="noopener noreferrer">Resume <span class="arrow" aria-hidden="true">↗</span></a></div>
          </div>
        </section>
        <section class="projects" id="projects" tabindex="-1" aria-labelledby="projects-heading">
          <h2 id="projects-heading">Selected projects</h2>
          {homeProjects.map(p => {
            const project = projects.find(project => project.id === p.id);
            if (!project) throw new Error(`Missing project: ${p.id}`);
            return <article class:list={['project-record', { 'project-with-media': p.id === 'tiny-recursive-model' || p.id === 'cost-effective-amr' }]} aria-labelledby={`title-${p.id}`}>
              <h3 id={`title-${p.id}`}>{p.title}</h3>
              {p.id === 'tiny-recursive-model' && <figure class="project-media lead-figure">
                <div class="lead-frame"><video controls playsinline preload="metadata" poster="/images/trm-demo-poster.jpg" width="1920" height="1200" aria-label="Tiny Recursive Model path-planning demonstration" aria-describedby="demo-caption"><source src="/media/trm-training-and-path-demo.mp4" type="video/mp4" /><a href="/media/trm-training-and-path-demo.mp4">Open the recording</a></video></div>
                <figcaption id="demo-caption">Recorded tutorial demonstration; evaluation not independently reproduced.</figcaption>
              </figure>}
              {p.id === 'cost-effective-amr' && <figure class="project-media rbot-figure"><div class="rbot-frame"><img data-reveal="slide" data-duration="620" src="/images/amr-prototypes.png" width="675" height="520" alt="RBot initial prototype, rocker mechanism and final prototype" loading="lazy" /></div><figcaption data-reveal="fade" data-delay="80">Initial prototype, rocker mechanism and final RBot prototype.</figcaption></figure>}
              <div class="project-copy" data-reveal="fade" data-duration="480">
                <dl class="facts"><dt>Objective</dt><dd>{p.objective}</dd><dt>My contribution</dt><dd>{p.contribution}</dd><dt>Tools</dt><dd>{project.data.tools}</dd><dt>Scope</dt><dd>{p.scope}</dd></dl>
                <a class="secondary-action project-link" href={`/projects/${p.id}/`} aria-label={`View project: ${p.title}`}>View project <span class="arrow" aria-hidden="true">↗</span></a>
              </div>
            </article>;
          })}
        </section>
        <section class="writing" id="writing" tabindex="-1" aria-labelledby="writing-heading">
          <h2 id="writing-heading">Writing & tutorials</h2>
          <WritingList featured />
        </section>
        <Contact footer />
      </main>
    </div>
  </div>
</Base>
